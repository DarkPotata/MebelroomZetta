generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Модель Пользователя
model User {
  id       Int       @id @default(autoincrement())
  email    String    @unique
  password String
  role     String    @default("USER") // Роли: USER или ADMIN
  products Product[] // Связь: один пользователь может добавить много товаров
}

// Модель Товара (основная сущность)
model Product {
  id          Int     @id @default(autoincrement())
  title       String
  price       Float
  category    String
  isAvailable Boolean @default(true)
  imageUrl    String?

  // Связь с пользователем (кто создал запись)
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
